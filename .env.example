# Optional ElevenLabs voice. Without this, the dashboard uses browser speech APIs.
# Create a key at https://elevenlabs.io/ and keep this file private.
ELEVENLABS_API_KEY=
# Use the same voice_id as on elevenlabs.io (Voice Library → copy ID).
ELEVENLABS_VOICE_ID=P3ZVpyU2GrK5DkbMsurX
# Match the model selected on the website (Speech Synthesis UI). v4 ≈ site quality.
ELEVENLABS_MODEL=eleven_v4
# mp3_44100_192 needs Creator+; 128 matches default web preview for most plans.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE=en
# Optional integer for slightly more consistent takes (still nondeterministic).
# ELEVENLABS_SEED=42
# Mirror the site's voice sliders (Voice settings on the web).
ELEVENLABS_STABILITY=0.50
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.00
ELEVENLABS_SPEAKER_BOOST=0

# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=1

# Wake word "Hey Lisa" in the HUD (browser speech in Chrome/Edge). Set 0 to disable autostart.
WAKE_WORD=1
# Optional Picovoice Porcupine (.ppn from console) — future; requires ui/wake/hey-lisa.ppn
# PORCUPINE_ACCESS_KEY=
# PORCUPINE_KEYWORD_PATH=wake/hey-lisa.ppn
