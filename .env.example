# Optional ElevenLabs voice. Without this, the dashboard uses browser speech APIs.
# Create a key at https://elevenlabs.io/ and keep this file private.
ELEVENLABS_API_KEY=
# Rachel (calm). Pick another id from your ElevenLabs account if needed.
ELEVENLABS_VOICE_ID=P3ZVpyU2GrK5DkbMsurX
# Softer than eleven_turbo_v2_5; try eleven_flash_v2_5 for lower latency.
ELEVENLABS_MODEL=eleven_multilingual_v2
# TTS tuning (0–1). Lower similarity + no speaker boost reduces harsh/saturation.
ELEVENLABS_STABILITY=0.58
ELEVENLABS_SIMILARITY=0.62
ELEVENLABS_STYLE=0.08
ELEVENLABS_SPEAKER_BOOST=0

# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=1
